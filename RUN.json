{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "EQUICREW_DATABASE_URL": {"dev": "sqlite:///./equicrew.db"},
        "EQUICREW_FRONTEND_ORIGIN": {"dev": "${service:web.origin}"},
        "EQUICREW_SESSION_TTL_HOURS": {"dev": "8"}
      },
      "test": [["${python}", "-m", "pytest", "-q"]],
      "lint": [
        ["${python}", "-m", "ruff", "format", "--check", "."],
        ["${python}", "-m", "ruff", "check", "."]
      ]
    }
  ]
}
